# Copy to /var/www/affylitics/.env on the server (chmod 600). Never commit the real file.
# Generate secrets with:  openssl rand -base64 32   (DATA_KEY)   /   openssl rand -hex 32   (others)

APP_ENV=production
PUBLIC_ORIGIN=https://netaffil.com
NEXT_PUBLIC_SITE_URL=https://netaffil.com

# Aiven PostgreSQL (16+). Use the service URI from the Aiven console; keep sslmode=require.
DATABASE_URL=postgres://avnadmin:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?sslmode=require
DB_MAX_CONNECTIONS=10

API_BIND=127.0.0.1:8100
API_URL=http://127.0.0.1:8100
API_INTERNAL_URL=http://127.0.0.1:8100
INTEL_URL=http://127.0.0.1:8200
INTEL_INTERNAL_URL=http://127.0.0.1:8200
WEBHOOK_BASE=https://netaffil.com/hooks
RAILS_PATH=/var/www/affylitics/packages/shared/rails.json
COOKIE_SECURE=true

DATA_KEY=           # base64 of 32 random bytes; encrypts payout details. Losing it makes saved methods unreadable.
HASH_SALT=          # 16+ chars; salts IP/user-agent hashes
INTERNAL_TOKEN=     # 32+ chars; API <-> intel

# Transactional email via Resend (verification, password reset, notifications).
RESEND_API_KEY=
EMAIL_FROM=NetAffil <hello@netaffil.com>

# Sign in with Google (optional). Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID (Web application). Authorized redirect URI: https://netaffil.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# KYC (either or both)
SMILEID_PARTNER_ID=
SMILEID_API_KEY=
SMILEID_BASE=https://api.smileidentity.com
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
KYC_SIMULATE=0      # 1 only on a dev machine; ignored when APP_ENV=production

# Advertiser escrow collection
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Publisher payouts
PAYSTACK_SECRET_KEY=
MPESA_BASE=https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_INITIATOR=
MPESA_SECURITY_CREDENTIAL=
MPESA_CALLBACK_TOKEN=
PAYPAL_BASE=https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
